@page
@model SettingsModel
@{
    ViewData["PageModel"] = Model;
    var t = Model.T;
}
<div class="wrap">
    <h1>@t.SettingsTitle</h1>
    <p class="muted">@t.SettingsSubtitle</p>
    @if (Model.Saved)
    {
        <p class="ok">@t.SettingsSaved</p>
    }
    @if (Model.Domain is not null)
    {
        <div class="card" style="margin-bottom:16px">
            <h3>HTTP</h3>
            <div class="kv">
                <div class="k">Host</div><div class="v mono">@Model.Domain.Host</div>
                <div class="k">IP</div><div class="v mono">@Model.OrDash(Model.Domain.Ip)</div>
                <div class="k">SSL</div><div class="v mono">@t.Pick("متوقف", "off")</div>
            </div>
            <p class="@(Model.Domain.Secure ? "ok" : "error")" style="margin-top:12px">@t.Pick(Model.Domain.SummaryAr, Model.Domain.SummaryEn)</p>
        </div>
    }
    <div class="card" style="margin-bottom:16px">
        <h3>@t.Pick("البريد", "Mail")</h3>
        <p class="@(Model.MailReady ? "ok" : "error")">@(Model.MailReady ? t.MailLive : t.MailOffline) · @Model.MailChannel</p>
        <p class="muted">@t.SettingsKeysHint</p>
    </div>
    <form method="post" class="card">
        <label>@t.Pick("رابط الموقع", "Site URL")</label>
        <input asp-for="SiteUrl" dir="ltr" />
        <label>@t.Pick("عنوان المرسل", "From")</label>
        <input asp-for="MailFrom" dir="ltr" />
        <label>Supabase</label>
        <input asp-for="SupabaseUrl" dir="ltr" />
        <p>
            <button class="btn-primary" asp-page-handler="Save">@t.Pick("حفظ الإعدادات", "Save settings")</button>
        </p>
    </form>
</div>
