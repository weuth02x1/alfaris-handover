@page "/Handovers/Report/{id}"
@model Alfaris.Handover.Pages.Handovers.ReportModel
@{
    ViewData["PageModel"] = Model;
    var t = Model.T;
    var h = Model.Item!;
    var manager = Model.Store.Person(h.ManagerApproval?.ById);
    var hrUser = Model.Store.Person(h.HrApproval?.ById);
}
<div class="wrap">
    <p class="no-print"><a href="/Handovers/@h.Id">@t.Back</a> · <button class="btn-primary" type="button" onclick="window.print()">@t.ReportPrint</button></p>
    <div class="receipt">
        <div class="receipt-head">
            <img src="~/brand/alfaris-lockup.png" alt="Alfaris" height="44" />
            <span style="margin-inline-start:auto;letter-spacing:2px;font-size:11px;color:var(--gold)">ALFARIS GROUP</span>
        </div>
        <div class="receipt-body">
            <h1 style="margin:0">إيصال تسليم المهام</h1>
            <p class="muted" dir="ltr">Employee Handover Receipt</p>
            <p class="mono">No. @h.Number · Request @h.RequestRef · Issued @t.Date(h.FinalizedAt, true)</p>
            <h3>بيانات الموظف · Employee details</h3>
            <div class="kv">
                <div class="k">اسم الموظف</div><div class="v">@h.Employee.NameAr · @h.Employee.NameEn</div>
                <div class="k">الرقم الوظيفي</div><div class="v mono">@h.Employee.Id</div>
                <div class="k">المسمى الوظيفي</div><div class="v">@h.Employee.JobTitleAr · @h.Employee.JobTitleEn</div>
                <div class="k">المدير المباشر</div><div class="v">@Model.OrDash(h.Employee.ManagerNameAr) · @Model.OrDash(h.Employee.ManagerNameEn)</div>
                <div class="k">الإدارة</div><div class="v">@h.Employee.DepartmentAr · @h.Employee.DepartmentEn</div>
                <div class="k">القسم</div><div class="v">@h.Employee.SectionAr · @h.Employee.SectionEn</div>
                <div class="k">سبب الخروج</div><div class="v">@t.Type(h.Type)</div>
                <div class="k">آخر يوم عمل</div><div class="v">@t.Date(h.LastWorkingDay)</div>
                <div class="k">تاريخ العودة</div><div class="v">@t.Date(h.ReturnDate)</div>
            </div>
            <h3 style="margin-top:20px">@t.Tasks</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@t.TaskTitle</th>
                        <th>@t.Assignee</th>
                        <th>@t.DueDate</th>
                        <th>@t.AcceptedAt</th>
                    </tr>
                </thead>
                <tbody>
                @{ var n = 0; }
                @foreach (var task in h.Tasks)
                {
                    n++;
                    var assignee = Model.Store.Person(task.AssigneeId);
                    <tr>
                        <td>@n</td>
                        <td>
                            <strong>@task.Title</strong>
                            <div class="muted">@task.Details</div>
                            @if (!string.IsNullOrWhiteSpace(task.AcceptNote)) { <div class="ok">@task.AcceptNote</div> }
                        </td>
                        <td>
                            @Model.NameOf(assignee)
                            <div class="muted">@(assignee?.NameEn)</div>
                            <div class="muted mono">@task.AssigneeId</div>
                        </td>
                        <td>@t.Date(task.DueDate)</td>
                        <td>@t.Date(task.AcceptedAt, true)</td>
                    </tr>
                }
                </tbody>
            </table>
            @if (!string.IsNullOrWhiteSpace(h.GeneralNotes))
            {
                <p><strong>@t.GeneralNotes</strong><br />@h.GeneralNotes</p>
            }
            <h3>@t.Approvals</h3>
            <div class="sig-grid">
                <div class="sig">
                    <div class="muted">الموظف (المُسلِّم) · Employee</div>
                    <strong>@h.Employee.NameAr</strong>
                    <div class="muted">@h.Employee.NameEn</div>
                    <div class="ok">@t.Date(h.SubmittedAt, true)</div>
                </div>
                <div class="sig">
                    <div class="muted">المدير المباشر · Direct manager</div>
                    <strong>@Model.NameOf(manager)</strong>
                    <div class="muted">@(manager?.NameEn)</div>
                    <div class="ok">@t.Date(h.ManagerApproval?.At, true)</div>
                    @if (!string.IsNullOrWhiteSpace(h.ManagerApproval?.Comment)) { <div class="muted">@h.ManagerApproval.Comment</div> }
                </div>
                <div class="sig">
                    <div class="muted">الموارد البشرية · Human Resources</div>
                    <strong>@Model.NameOf(hrUser)</strong>
                    <div class="muted">@(hrUser?.NameEn)</div>
                    <div class="ok">@t.Date(h.HrApproval?.At, true)</div>
                    @if (!string.IsNullOrWhiteSpace(h.HrApproval?.Comment)) { <div class="muted">@h.HrApproval.Comment</div> }
                </div>
            </div>
            <p class="muted" style="margin-top:16px">@t.ReportFinalNote</p>
            @if (!string.IsNullOrWhiteSpace(h.DocumentHash))
            {
                <p class="muted mono">SHA-256: @h.DocumentHash</p>
            }
            @if (!string.IsNullOrWhiteSpace(h.HrmsDocumentId))
            {
                <p class="muted mono">@t.ReportHrms: @h.HrmsDocumentId</p>
            }
        </div>
    </div>
</div>
