@page "/Handovers/Report/{id}"
@model Alfaris.Handover.Pages.Handovers.ReportModel
@{
    ViewData["PageModel"] = Model;
    var t = Model.T;
    var h = Model.Item!;
}
<div class="wrap">
    <p class="no-print"><a href="/Handovers/@h.Id">@t.Back</a> · <button class="btn-primary" onclick="window.print()">@t.ReportPrint</button></p>
    <img src="~/brand/alfaris-lockup.png" alt="Alfaris" height="56" />
    <h1>@t.ReportTitle</h1>
    <p>@h.Number · @h.RequestRef</p>
    <p>@Model.NameSnap(h.Employee) · @t.Pick(h.Employee.JobTitleAr, h.Employee.JobTitleEn)</p>
    <p>@t.Type(h.Type) · @h.LastWorkingDay</p>
    @foreach (var task in h.Tasks)
    {
        <div class="task">
            <strong>@task.Title</strong>
            <p>@task.Details</p>
            <p class="muted">@t.TaskStatus(task.Status)</p>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(h.DocumentHash))
    {
        <p class="muted">@t.Pick("بصمة المستند", "Document fingerprint"): @h.DocumentHash</p>
    }
    @if (!string.IsNullOrWhiteSpace(h.HrmsDocumentId))
    {
        <p class="muted">@h.HrmsDocumentId</p>
    }
    <p>@t.Pick("هذا المستند صادر آلياً من نظام تسليم المهام ومقفل بعد الاعتماد النهائي.", "This document was generated by the handover system and locked after final approval.")</p>
</div>
